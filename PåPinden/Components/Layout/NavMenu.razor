@implements IDisposable
@inject NavigationManager NavigationManager

<div class="nav-menu">
    <a class="brand" href="" @onclick='() => InvokeAction("feed")' aria-label="PåPinden home">
        <img class="brand-logo" src="images/papinden-logo.png" alt="På Pinden" />
    </a>

    <div class="nav-caption">YOUR SPACE</div>
    <nav class="main-nav" aria-label="Community navigation">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick='() => InvokeAction("feed")' aria-label="Feed">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z" /></svg>
            <span>Feed</span>
        </NavLink>

        <button class="nav-link action-link @(ActiveAction == "discover" ? "active" : string.Empty)" type="button" @onclick='() => InvokeAction("discover")' aria-label="Discover and search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7" /><path d="m16 16 5 5" /></svg>
            <span>Discover</span>
        </button>

        <button class="nav-link action-link @(ActiveAction == "create" ? "active" : string.Empty)" type="button" @onclick='() => InvokeAction("create")' aria-label="Create a post">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></svg>
            <span>Create</span>
        </button>

        <button class="nav-link action-link @(ActiveAction == "notifications" ? "active" : string.Empty)" type="button" @onclick='() => InvokeAction("notifications")' aria-label="Notifications">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 4.7-8.8 11.4-8.8 11.4S3.2 13.5 3.2 8.8A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z" /></svg>
            <span>Activity</span>
        </button>

        <button class="nav-link action-link @(ActiveAction == "messages" ? "active" : string.Empty)" type="button" @onclick='() => InvokeAction("messages")' aria-label="Messages">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7.2 18-3.8-7-7-3.8L21 3Z" /><path d="M10 14 21 3" /></svg>
            <span>Messages</span>
        </button>

        <button class="nav-link action-link @(ActiveAction == "saved" ? "active" : string.Empty)" type="button" @onclick='() => InvokeAction("saved")' aria-label="Saved projects">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21l-6-4-6 4V4.5Z" /></svg>
            <span>Saved</span>
        </button>

        <AuthorizeView>
            <Authorized>
                <a class="nav-link" href="/Account/Manage" data-enhance-nav="false" aria-label="Your profile">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.7" /><path d="M4.5 20c.6-3.8 3.5-5.8 7.5-5.8s6.9 2 7.5 5.8" /></svg>
                    <span>Profile</span>
                </a>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="nav-bottom">
        <AuthorizeView>
            <Authorized>
                <div class="account-card">
                    <a href="/Account/Manage" class="account-link" data-enhance-nav="false" title="Manage your account">
                        <span class="account-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.7" /><path d="M4.5 20c.6-3.8 3.5-5.8 7.5-5.8s6.9 2 7.5 5.8" /></svg>
                        </span>
                        <span class="account-name">@context.User.Identity?.Name</span>
                    </a>
                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="logout-button" title="Sign out" aria-label="Sign out">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h5" /><path d="m15 16 4-4-4-4M19 12H9" /></svg>
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="account-card signed-out">
                    <a class="account-link" href="/Account/Login" data-enhance-nav="false">
                        <span class="account-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.7" /><path d="M4.5 20c.6-3.8 3.5-5.8 7.5-5.8s6.9 2 7.5 5.8" /></svg>
                        </span>
                        <span class="account-name">Sign in</span>
                    </a>
                    <a class="join-link" href="/Account/Register" data-enhance-nav="false">Join</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        <div class="sidebar-note">Lorem ipsum dolor sit amet.</div>
    </div>
</div>

@code {
    [Parameter]
    public string? ActiveAction { get; set; }

    [Parameter]
    public EventCallback<string> OnAction { get; set; }

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private Task InvokeAction(string action) => OnAction.InvokeAsync(action);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
