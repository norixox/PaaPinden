@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar-shell" aria-label="Main navigation">
        <NavMenu ActiveAction="@activeAction" OnAction="HandleNavigationAction" />
    </aside>

    <div class="workspace-shell">
        <header class="topbar @(searchOpen ? "search-active" : string.Empty)">
            <div class="topbar-copy">
                <span class="eyebrow">Lorem ipsum</span>
                <span class="topbar-title">Lorem ipsum dolor sit amet.</span>
            </div>

            @if (searchOpen)
            {
                <div class="search-box">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" /></svg>
                    <input @bind="searchQuery" @bind:event="oninput" type="search" placeholder="Search knitting topics..." aria-label="Search knitting topics" />
                    <button class="quiet-button search-close" type="button" @onclick="CloseSearch" aria-label="Close search">Close</button>
                </div>
            }
            else
            {
                <button class="topbar-search" type="button" @onclick="OpenSearch" aria-label="Open search">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" /></svg>
                    <span>Search the community</span>
                </button>
            }

            <div class="topbar-actions">
                <button class="icon-button create-button" type="button" @onclick="OpenComposer" aria-label="Create a post" title="Create a post">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></svg>
                </button>
            </div>
        </header>

        @if (activePanel is not null)
        {
            <section class="utility-popover" aria-live="polite" aria-label="@PanelTitle">
                <div class="popover-heading">
                    <div>
                        <span class="eyebrow">Lorem ipsum</span>
                        <h2>@PanelTitle</h2>
                    </div>
                    <button class="quiet-button" type="button" @onclick="ClosePanel" aria-label="Close panel">Close</button>
                </div>
                <p>@PanelMessage</p>
            </section>
        }

        <main class="main-grid">
            <section class="feed-column" aria-label="Community feed">
                <div class="feed-intro">
                    <div class="feed-intro-copy">
                        <span class="eyebrow">Lorem ipsum</span>
                        <h1>Lorem ipsum dolor sit amet.</h1>
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                    </div>
                </div>

                <article class="route-surface">
                    @Body
                </article>

                @if (draftSaved)
                {
                    <div class="draft-status" role="status">
                        <span class="status-dot"></span>
                        Draft saved for this session.
                    </div>
                }
            </section>

        </main>
    </div>
</div>

@if (composerOpen)
{
    <div class="composer-backdrop" @onclick="CloseComposer">
        <section class="composer-dialog" role="dialog" aria-modal="true" aria-labelledby="composer-title" @onclick:stopPropagation="true">
            <div class="composer-heading">
                <div>
                    <span class="eyebrow">Lorem ipsum</span>
                    <h2 id="composer-title">Lorem ipsum dolor sit amet.</h2>
                </div>
                <button class="quiet-button" type="button" @onclick="CloseComposer" aria-label="Close composer">Close</button>
            </div>
            <label class="visually-hidden" for="post-draft">Your project update</label>
            <textarea id="post-draft" @bind="composerText" placeholder="Lorem ipsum dolor sit amet..." rows="5"></textarea>
            <div class="composer-footer">
                <span>A draft stays in this session.</span>
                <button class="primary-button" type="button" @onclick="SaveDraft" disabled="@string.IsNullOrWhiteSpace(composerText)">Save draft</button>
            </div>
        </section>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    <span>An unexpected error occurred.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">Close</button>
</div>

@code {
    private bool searchOpen;
    private bool composerOpen;
    private bool draftSaved;
    private string? activeAction;
    private string? activePanel;
    private string searchQuery = string.Empty;
    private string composerText = string.Empty;

    private string PanelTitle => activePanel switch
    {
        "notifications" => "Notifications",
        "messages" => "Messages",
        "saved" => "Saved stitches",
        _ => "Your corner"
    };

    private string PanelMessage => activePanel switch
    {
        "notifications" => "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
        "messages" => "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
        "saved" => "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
        _ => "Lorem ipsum dolor sit amet."
    };

    private void HandleNavigationAction(string action)
    {
        if (action == "feed")
        {
            ResetInteractionState();
            return;
        }

        activeAction = action;
        activePanel = null;

        switch (action)
        {
            case "discover":
                searchOpen = !searchOpen;
                composerOpen = false;
                break;
            case "create":
                OpenComposer();
                break;
            case "notifications":
            case "messages":
            case "saved":
                searchOpen = false;
                composerOpen = false;
                activePanel = action;
                break;
        }
    }

    private void ResetInteractionState()
    {
        activeAction = null;
        activePanel = null;
        searchOpen = false;
        composerOpen = false;
    }

    private void OpenSearch()
    {
        searchOpen = true;
        composerOpen = false;
        activePanel = null;
        activeAction = "discover";
    }

    private void CloseSearch()
    {
        searchOpen = false;
        activeAction = null;
    }

    private void OpenComposer()
    {
        composerOpen = true;
        searchOpen = false;
        activePanel = null;
        activeAction = "create";
    }

    private void CloseComposer()
    {
        composerOpen = false;
        activeAction = null;
    }

    private void ClosePanel()
    {
        activePanel = null;
        activeAction = null;
    }

    private void SaveDraft()
    {
        if (!string.IsNullOrWhiteSpace(composerText))
        {
            draftSaved = true;
            composerOpen = false;
            activeAction = null;
        }
    }
}
